# DeepSeek OCR Application Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

# Model Configuration
MODEL_NAME=deepseek-ai/DeepSeek-OCR
HF_HOME=/models

# HuggingFace Mirror Configuration
HF_ENDPOINT=https://hf-mirror.com
TRANSFORMERS_OFFLINE=0

# Upload Configuration
MAX_UPLOAD_SIZE_MB=100

# Processing Configuration
BASE_SIZE=1024
IMAGE_SIZE=640
CROP_MODE=true

# PDF OCR 代理服务环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# API认证token（必填）
AUTH_TOKEN=your_secure_token_here

# Paperless配置（可选，不配置则跳过上传）
PAPERLESS_URL=https://your-paperless-instance.com
PAPERLESS_API_KEY=your_paperless_api_key_here

# 后端OCR服务地址（必填）
BACKEND_OCR_URL=http://localhost:8000

# 日志级别（可选，默认INFO）
LOG_LEVEL=INFO

# 本地保存配置（OCR处理后文件保存到本地）
LOCAL_SAVE_ENABLED=true
# 注意：在Docker容器中，保存路径为/app/processed_pdfs，通过卷映射到宿主机的./processed_pdfs目录
LOCAL_SAVE_DIR=/app/processed_pdfs
